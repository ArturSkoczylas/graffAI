# Skopiuj do .env i wypełnij. .env nie trafia do repo (patrz .gitignore).

# --- IMAP: to samo konto, które masz skonfigurowane w Thunderbirdzie ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=biuro@example.com
IMAP_PASSWORD=haslo-aplikacji
IMAP_USE_SSL=true
# Gmail: zwykle "[Gmail]/Drafts"; inne serwery: "Drafts", "Szkice" itp.
IMAP_DRAFTS_FOLDER=Drafts

# --- Serwer HTTP (przycisk w Thunderbirdzie woła POST /draft) ---
# Zostaje lokalnie na tej maszynie – nie wystawiaj API_HOST poza 127.0.0.1.
API_HOST=127.0.0.1
API_PORT=8765

# --- Agent ---
# Instrukcje bazowe: agents/harness-agent.md. Dostępne skille (odpowiedzi-klientom, pdf-check,
# margin-check, wycena) są wczytywane na żądanie – patrz skills/*/SKILL.md.

AI_PROVIDER=claude
AI_MODEL=claude-sonnet-5-5
AI_API_KEY=sk-ant-...
AI_MAX_TOKENS=3000

# --- Reszta ---
# Domyślnie = IMAP_USER; ustaw, jeśli odpowiedzi mają wychodzić z innego adresu/aliasu
FROM_ADDRESS=
