# Skopiuj do .env i wypełnij. .env nie trafia do repo (patrz .gitignore).

# --- IMAP: to samo konto, które masz skonfigurowane w Thunderbirdzie ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=biuro@example.com
IMAP_PASSWORD=haslo-aplikacji
IMAP_USE_SSL=true
IMAP_INBOX_FOLDER=INBOX
# Gmail: zwykle "[Gmail]/Drafts"; inne serwery: "Drafts", "Szkice" itp.
IMAP_DRAFTS_FOLDER=Drafts

# --- Wykrywanie nowej poczty ---
# idle = push, natychmiastowe (wymaga wsparcia IMAP IDLE po stronie serwera)
# poll = sprawdzanie co POLL_INTERVAL_SECONDS
DETECTION_MODE=idle
POLL_INTERVAL_SECONDS=60

# --- Agent ---
# true = użyj skills/odpowiedzi-klientom (szablony Drukarni Gutenberg)
# false = ogólny szkic odpowiedzi, bez szablonów firmowych
USE_ODPOWIEDZI_SKILL=true

AI_PROVIDER=claude
AI_MODEL=claude-sonnet-5-5
AI_API_KEY=sk-ant-...
AI_MAX_TOKENS=3000

# --- Reszta ---
# Domyślnie = IMAP_USER; ustaw, jeśli odpowiedzi mają wychodzić z innego adresu/aliasu
FROM_ADDRESS=
